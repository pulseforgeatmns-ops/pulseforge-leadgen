  "escalationRules": [
    {
      "id": "ci-workflows",
      "paths": [".github/workflows/", ".github/ci/", ".github/scripts/ci-plan-pr.js"],
      "suites": [
        "global",
        "signal-v1",
        "paige-social",
        "anchor-outbound",
        "decision-shadow",
        "revenue-postgres",
        "walkthrough",
        "spec245-evidence",
        "anchor-canonical-outbound",
        "studio-substral"
      ],
      "reason": "CI selector or workflow change — re-run former PR-critical suites (Max full suite was never merge-blocking; see full-regression.yml)"
    },
    {
      "id": "npm-dependencies",
      "paths": ["package.json", "package-lock.json"],
      "suites": [
        "global",
        "revenue-postgres",
        "anchor-outbound",
        "paige-social",
        "decision-shadow",
        "signal-v1"
      ],
      "reason": "Dependency graph affects module load and Postgres-backed agents"
    },
    {
      "id": "server-entry",
      "paths": ["server.js"],
      "suites": ["global", "anchor-outbound", "signal-v1", "revenue-postgres", "decision-shadow"],
      "reason": "Central route mount and startup side-effects"
    },
    {
      "id": "shared-db",
      "paths": ["db.js", "dbClient.js", "middleware/", "utils/clientContext.js"],
      "suites": ["global", "revenue-postgres", "anchor-outbound", "paige-social"],
      "reason": "Shared persistence and tenant scoping"
    },
    {
      "id": "migrations",
      "paths": ["migrations/"],
      "suites": ["global", "revenue-postgres", "spec245-evidence"],
      "reason": "Schema migrations can break disposable harness and evidence invariants"
    },
    {
      "id": "shared-routing",
      "paths": ["routes/cron.js", "routes/api.js"],
      "suites": ["global", "anchor-outbound", "revenue-postgres", "max"],
      "reason": "Cron and dashboard API wiring for agents"
    },
    {
      "id": "acquisition-mission-core",
      "paths": ["packages/acquisition-mission/"],
      "suites": ["anchor-outbound", "max", "paige-social"],
      "reason": "Mission orchestration shared by outbound and Max workspace"
    }
  ],
  "failClosedSuites": [
    "global",
    "signal-v1",
    "paige-social",
    "anchor-outbound",
    "decision-shadow",
    "revenue-postgres",
    "walkthrough",
    "spec245-evidence",
    "anchor-canonical-outbound",
    "studio-substral"
  ]

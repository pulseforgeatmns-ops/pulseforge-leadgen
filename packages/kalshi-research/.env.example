# Paper trading is intentionally the only supported execution mode.
KALSHI_RESEARCH_MODE=paper
KALSHI_RESEARCH_KALSHI_API_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_RESEARCH_KALSHI_TIMEOUT_SECONDS=10
# Public market-data collection does not require an API key. Keep these blank
# until a future read-only account check is explicitly implemented.
KALSHI_RESEARCH_KALSHI_API_KEY_ID=
KALSHI_RESEARCH_KALSHI_PRIVATE_KEY_PATH=
KALSHI_RESEARCH_KALSHI_BTC_MARKET_KEYWORD=BTC
# Comma-separated series tickers. KXBTC15M is Kalshi's Bitcoin price up/down 15-minute series.
KALSHI_RESEARCH_BTC_SERIES_TICKERS=KXBTC15M
KALSHI_RESEARCH_COLLECTOR_MARKET_LIMIT=5000
KALSHI_RESEARCH_COLLECTOR_INTERVAL_SECONDS=10
KALSHI_RESEARCH_DATABASE_URL=sqlite:///kalshi_research.db
KALSHI_RESEARCH_INITIAL_CASH_CENTS=100000
KALSHI_RESEARCH_MAX_POSITION_CENTS=10000
KALSHI_RESEARCH_MAX_CONTRACTS_PER_MARKET=1
KALSHI_RESEARCH_MAX_DAILY_LOSS_CENTS=5000
KALSHI_RESEARCH_MAX_OPEN_ORDERS=20
KALSHI_RESEARCH_LOG_LEVEL=INFO

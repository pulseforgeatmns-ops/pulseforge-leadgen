FROM postgres:18-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-boto3 python3-requests ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY scripts/migration/sendRenderRestoreTicket.py /usr/local/bin/sendRenderRestoreTicket.py
USER postgres
CMD ["python3", "/usr/local/bin/sendRenderRestoreTicket.py"]

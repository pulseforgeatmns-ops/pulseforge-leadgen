FROM postgres:18-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-boto3 python3-requests ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY scripts/migration/sendFinalRestoreTicket.py /usr/local/bin/
USER postgres
ENV PYTHONUNBUFFERED=1
CMD ["sh", "-c", "python3 /usr/local/bin/sendFinalRestoreTicket.py; sleep infinity"]

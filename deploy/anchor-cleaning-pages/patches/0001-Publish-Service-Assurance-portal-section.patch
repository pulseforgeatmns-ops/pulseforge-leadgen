@@ -0,0 +1,248 @@
+/* Shared styles for ServiceAssuranceSection — import in Framer or link from static site */
+
+.service-assurance {
+  background: var(--cream, #f6f1e8);
+  padding: clamp(96px, 11vw, 168px) 0 0;
+  position: relative;
+  color: #10202d;
+}
+
+.service-assurance::before {
+  content: "";
+  position: absolute;
+  top: 0;
+  left: 50%;
+  transform: translateX(-50%);
+  width: min(1240px, 92vw);
+  height: 1px;
+  background: linear-gradient(90deg, transparent, #c49a55 18%, #c49a55 82%, transparent);
+  opacity: 0.65;
+}
+
+.service-assurance-hero {
+  display: grid;
+  grid-template-columns: minmax(280px, 0.94fr) minmax(320px, 1.06fr);
+  gap: clamp(40px, 5.5vw, 96px);
+  align-items: start;
+  margin-bottom: clamp(64px, 7vw, 112px);
+}
+
+.service-assurance-eyebrow {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: 0.2em;
+  text-transform: uppercase;
+  color: #8a6534;
+  margin-bottom: 22px;
+}
+
+.service-assurance-eyebrow::before {
+  content: "";
+  width: 28px;
+  height: 1px;
+  background: #c49a55;
+  flex-shrink: 0;
+}
+
+.service-assurance-story h2 {
+  font-family: "Fraunces", Georgia, serif;
+  font-size: clamp(44px, 5.4vw, 82px);
+  line-height: 0.98;
+  max-width: 11ch;
+  margin-bottom: 28px;
+  color: #10202d;
+}
+
+.service-assurance-body {
+  display: grid;
+  gap: 18px;
+  font-size: 18px;
+  line-height: 1.78;
+  color: #46535f;
+  max-width: 38ch;
+}
+
+.service-assurance-proof {
+  list-style: none;
+  display: grid;
+  gap: 26px;
+  margin: 38px 0 42px;
+  padding: 0;
+}
+
+.service-assurance-proof h3 {
+  font-family: "Fraunces", Georgia, serif;
+  font-size: clamp(22px, 2.2vw, 28px);
+  font-weight: 500;
+  color: #10202d;
+  margin-bottom: 8px;
+}
+
+.service-assurance-proof p {
+  font-size: 16px;
+  line-height: 1.7;
+  color: #52606b;
+  max-width: 36ch;
+}
+
+.service-assurance-proof li {
+  padding-left: 18px;
+  border-left: 2px solid #c49a55;
+}
+
+.service-assurance-cta {
+  display: inline-flex;
+}
+
+.portal-mockup-frame {
+  margin: 0;
+  background: #fff;
+  border: 1px solid rgba(17, 31, 43, 0.1);
+  border-radius: 10px;
+  box-shadow: 0 32px 90px rgba(7, 19, 31, 0.11);
+  padding: clamp(10px, 1.2vw, 14px);
+  transition: transform 700ms cubic-bezier(0.22, 0.61, 0.36, 1), box-shadow 700ms ease;
+}
+
+.portal-mockup-frame picture {
+  display: block;
+  width: 100%;
+}
+
+.portal-mockup-frame img {
+  width: 100%;
+  height: auto;
+  display: block;
+  border-radius: 6px;
+}
+
+.portal-mockup-frame figcaption {
+  margin-top: 14px;
+  padding: 0 6px 4px;
+  font-size: 15px;
+  line-height: 1.55;
+  color: #52606b;
+}
+
+.portal-mockup-frame--primary {
+  position: relative;
+  top: -6px;
+}
+
+.js-ready .portal-mockup-frame--primary.in {
+  transform: translateY(-4px);
+}
+
+.portal-mockup-frame--device {
+  max-width: 320px;
+  margin-left: auto;
+  margin-right: auto;
+  box-shadow: 0 36px 80px rgba(7, 19, 31, 0.14);
+}
+
+.service-assurance-panels {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: clamp(20px, 2.5vw, 28px);
+  margin-bottom: clamp(72px, 8vw, 120px);
+}
+
+.portal-feature-panel {
+  background: #fff;
+  border: 1px solid rgba(17, 31, 43, 0.08);
+  padding: clamp(28px, 3.5vw, 44px);
+  display: grid;
+  gap: 22px;
+  align-content: start;
+}
+
+.portal-feature-panel--cream {
+  background: #fbf8f1;
+}
+
+.portal-feature-panel h3 {
+  font-family: "Fraunces", Georgia, serif;
+  font-size: clamp(26px, 2.8vw, 36px);
+  line-height: 1.12;
+  color: #10202d;
+  max-width: 16ch;
+}
+
+.portal-feature-panel p {
+  font-size: 17px;
+  line-height: 1.72;
+  color: #52606b;
+  max-width: 38ch;
+}
+
+.facility-assessment-cta {
+  background: #08131f;
+  color: #fff;
+  padding: clamp(56px, 6vw, 88px) clamp(28px, 4vw, 48px);
+  margin-left: calc((100vw - min(1240px, 100vw)) / -2);
+  margin-right: calc((100vw - min(1240px, 100vw)) / -2);
+  text-align: center;
+  display: grid;
+  justify-items: center;
+  gap: 22px;
+}
+
+.facility-assessment-cta h2 {
+  font-family: "Fraunces", Georgia, serif;
+  font-size: clamp(34px, 4.2vw, 56px);
+  line-height: 1.05;
+  max-width: 16ch;
+  color: #fff;
+}
+
+.facility-assessment-cta p {
+  font-size: 18px;
+  line-height: 1.75;
+  color: #cbd4db;
+  max-width: 42ch;
+}
+
+@media (max-width: 980px) {
+  .service-assurance-hero {
+    grid-template-columns: 1fr;
+  }
+
+  .portal-mockup-frame--primary {
+    top: 0;
+  }
+
+  .service-assurance-panels {
+    grid-template-columns: 1fr;
+  }
+
+  .portal-mockup-frame--device {
+    max-width: 280px;
+  }
+}
+
+@media (max-width: 760px) {
+  .service-assurance-story h2 {
+    max-width: 12ch;
+  }
+
+  .service-assurance-body {
+    max-width: none;
+  }
+
+  .portal-feature-panel .portal-mockup-frame--device {
+    max-width: min(280px, 78vw);
+  }
+
+  .portal-feature-panel .portal-mockup-frame:not(.portal-mockup-frame--device) {
+    overflow: hidden;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .portal-mockup-frame {
+    transition: none;
+  }
+}

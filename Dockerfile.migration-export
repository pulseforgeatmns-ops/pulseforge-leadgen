# Dedicated one-shot export worker. Not an application/agent container.
FROM postgres:18-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-boto3 ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY scripts/migration/exportRailwayToBucket.py /usr/local/bin/exportRailwayToBucket.py
USER postgres
CMD ["python3", "/usr/local/bin/exportRailwayToBucket.py"]

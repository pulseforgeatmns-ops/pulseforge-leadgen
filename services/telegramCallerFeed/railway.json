{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/services/telegramCallerFeed/Dockerfile",
    "watchPatterns": [
      "/services/telegramCallerFeed/**",
      "/packages/signal-v1/prospective/constants.js",
      "/package.json",
      "/package-lock.json",
      "/services/signalOperator/pilotGate.js",
      "/packages/signal-v1/prospective/caExtraction.js",
      "/packages/signal-v1/acquisition/solanaAddress.js",
      "/services/signalOperator/runtimeLimits.js",
      "/services/signalOperator/operationGate.js"
    ]
  },
  "deploy": {
    "startCommand": "node services/telegramCallerFeed/server.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "numReplicas": 1,
    "limitOverride": {
      "containers": {
        "cpu": 0.25,
        "memoryBytes": 268435456
      }
    },
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

FROM postgres:18-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-boto3 ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY scripts/migration/restoreGatewayContract.py /usr/local/bin/restoreGatewayContract.py
COPY scripts/migration/restoreGatewayRender.py /usr/local/bin/restoreGatewayRender.py
COPY docs/migration/railway-source-catalog-20261117.json /usr/local/share/migration/railway-source-catalog-20261117.json
COPY docs/migration/railway-restore-contract-20261121.json /usr/local/share/migration/railway-restore-contract-20261121.json
USER postgres
ENV PYTHONUNBUFFERED=1
CMD ["python3", "/usr/local/bin/restoreGatewayRender.py"]
